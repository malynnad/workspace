{
  // 本项目所有 Python 都走 workspace/.venv，别用系统的 python3（那里没 PySide6）
  "python.defaultInterpreterPath": "/Users/dannylam/WorkBuddy/Workspace/workspace/.venv/bin/python",
  "python.terminal.activateEnvironment": true,

  // Code Runner（Ctrl+Alt+N）的「运行」按钮：强制用 venv 解释器
  "code-runner.executorMap": {
    "python": "/Users/dannylam/WorkBuddy/Workspace/workspace/.venv/bin/python -u"
  },
  // GUI 程序放终端里跑，别用只读的 OUTPUT 面板
  "code-runner.runInTerminal": true
}
